##### Main ###################################################################
export LC_ALL=C # override any user-defined locale
set -Eeuo pipefail ; shopt -s inherit_errexit ; # improved err handling

BASEDIR=$(dirname "${BASH_SOURCE[0]}")

#shellcheck source-path=SCRIPTDIR/../util
. "$BASEDIR/../util/util_err_functions.sh"
. "$BASEDIR/../util/util_test_functions.sh"
. "$BASEDIR/config.sh"

testset_init "$@"

tests=() TESTIMG=""
for p in "${TESTSET_PARM[@]}" ; do
	case "$p" in
		all)
			tests=( base rclone file imap )
			;;
		base|rclone|file|imap)
			tests+=( "$p" )
			;;
		!base|!rclone|!file|!imap)
			tests=( "${tests[@]/"${p:1}"}" )
			;;
		*)
			TESTIMG="$p"
	esac
done

printf "Executing tests %s with image %s\n" \
	"${tests[*]}" "${TESTIMG:-<temporary image>}"

test_expect_value "$(( ${#tests[@]} > 0 ? 1 : 0 ))" 1 \
	"Nr of tests to be executed"
test_is_cmdavail curl offlineimap jq "$TEST_SNAIL"

if testset_issuccess ; then
	if [ ! -d "$TESTSET_DIR/backup" ] ; then
		mkdir "$TESTSET_DIR/backup"
	fi
	test_chown "$TESTSET_DIR/backup"
	if [ -z "$TESTIMG" ] ; then
		TESTIMG="nafets227/backup:test"
		test_exec_cmd 0 "Build temporary image" \
			docker build -t "$TESTIMG" "$BASEDIR/.."
	fi
	test_init
fi

if testset_issuccess ; then
	for t in "${tests[@]}" ; do
		case "$t" in
			base)
				test_runempty
				test_email
				;;
			rclone)
				unset MAIL_TO MAIL_URL # disable mailing for following tests
				. "$BASEDIR/test-rclone.sh"
				test_rclone2file
				test_rclone2file_hist
				test_file2rclone
				;;
			file)
				unset MAIL_TO MAIL_URL # disable mailing for following tests
				. "$BASEDIR/test-file-hist.sh"
				. "$BASEDIR/test-file.sh"
				test_file
				test_file_hist
				;;
			imap)
				unset MAIL_TO MAIL_URL # disable mailing for following tests
				. "$BASEDIR/test-imap-hist.sh"
				. "$BASEDIR/test-imap.sh"
				test_imap
				test_imap_hist
				;;
			*)
				test_expect_value 1 0 "Unknown test \"$t\""
		esac
	done
fi

testset_summary || exit 1

exit 0
