##### Test Init ##############################################################
# Initialise tests including any necessary workaround
function test_init {

	my_fileopt=""

	if 	[[ "$OSTYPE" =~ darwin* ]] ; then
		my_ip="$USER@$(ipconfig getifaddr en0 en1)"
		my_fileopt="--macos"
		TEST_RSYNCOPT="--rsync-path=/opt/homebrew/bin/rsync"
	elif which "ip" >/dev/null ; then
		my_ip="$USER@$(set -o pipefail
			ip -4 -j a show dev docker0 primary |
			jq '.[].addr_info[0].local')"
		my_ip=${my_ip//\"}
		TEST_RSYNCOPT=""
	else
		my_ip=""
		test_expect_value "1" "0" \
			"Could not get IP (not on MacOS and command ip missing)"
		TEST_RSYNCOPT=""
	fi

	my_host="$HOSTNAME"
	: "$my_host" # make shellcheck happy

	return 0
}

##### Test chowner ###########################################################
# Parameters:
#     1 - test file to chown
function test_chown {
	if 	! [[ "$OSTYPE" =~ darwin* ]] ; then
		chown 41598:41598 "$1"
	fi

	return 0
}

##### Test Executer ##########################################################
# Parameters:
#     1 - command in custom backup shell
#     2 - expected RC [default: 0]
function test_exec_backupdocker {
	rc_exp="$1"
	shift

	if \
		! cat >"$TESTSET_DIR/backup/backup" <<<"$@" ||
		! chmod +x "$TESTSET_DIR/backup/backup"
	then
		printf "test_expect_value %s 0 \"%s\"\n" "$?" "Write backup script"
		return 1
	fi

	if ! cp ~/.ssh/id_ed25519 "$TESTSET_DIR/id_ed25519"
	then
		test_expect_value "$?" 0 "Copy SSH Key"
		return 1
	fi
	if 	! [[ "$OSTYPE" =~ darwin* ]] ; then
		if ! chown 41598:41598 "$TESTSET_DIR/id_ed25519" ; then
			test_expect_value "$?" 0 "chown SSH Key"
			return 1
		else
			test_expect_value 0 0 "not chowning SSH Key"
		fi
	else
		test_expect_value 0 0 "not chowning SSH Key"
	fi

	TEST_CALLDEPTH=1 \
	test_exec_cmd "$rc_exp" "Backup Command $*" \
		docker run \
			-v "$TESTSET_DIR/backup:/backup" \
			-v "$TESTSET_DIR/id_ed25519:/secrets/id_ed25519:ro" \
			-e DEBUG=1 \
			-e MAIL_TO \
			-e MAIL_FROM \
			-e MAIL_URL \
			-e MAIL_HOSTNAME \
			"$TESTIMG" \
			. /backup/backup

	return 0
}

##### Test: no custom script #################################################
function test_runempty {
	test_exec_cmd 1 "" \
		docker run "$TESTIMG"

	return $?
}

